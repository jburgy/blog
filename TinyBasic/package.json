{
  "dependencies": {
    "coi-serviceworker": "^0.1.6"
  },
  "name": "tinybasic",
  "version": "1.0.0",
  "description": "Port of TBIL to AssemblyScript",
  "main": "worker.js",
  "devDependencies": {
    "uwasi": "^1.6.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "npm run asbuild:wasi && vitest run",
    "asbuild:wasi": "npx -y --package assemblyscript asc assembly/wasi.ts --target wasi --use ScreenChar=assembly/wasiHost/ScreenChar --use KeyInChar=assembly/wasiHost/KeyInChar --use OutStr=assembly/wasiHost/OutStr"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jburgy/blog.git"
  },
  "author": "Jan Burgy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jburgy/blog/issues"
  },
  "homepage": "https://github.com/jburgy/blog#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/release.js",
      "types": "./build/release.d.ts"
    }
  }
}
