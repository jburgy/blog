{
  "name": "fourt2py",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser demo for FOURT.F (shape a waveform in the frequency domain), a plain-JS specialization (see web/fourt.pow2.mjs); wasm/fourt.c is an optional manual comparison build",
  "scripts": {
    "build:wasm": "${WASI_SDK_PATH}/bin/clang --sysroot=${WASI_SDK_PATH}/share/wasi-sysroot -O2 -mexec-model=reactor -Wl,--export=fourt_,--export=malloc,--export=free -o wasm/fourt.wasm wasm/fourt.c",
    "test": "vitest run --coverage web/",
    "benchmark": "npm run build:wasm && node web/benchmark.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
