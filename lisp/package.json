{
  "name": "lisp",
  "version": "1.0.0",
  "description": "https://justine.lol/sectorlisp/ in https://www.assemblyscript.org/",
  "main": "index.js",
  "scripts": {
    "test": "npm run asbuild:wasi && node tests/wasi.mjs",
    "asbuild:debug": "asc assembly/index.ts --target debug --use getchar=assembly/host/getchar --use putchar=assembly/host/putchar",
    "asbuild:release": "asc assembly/index.ts --target release --use getchar=assembly/host/getchar --use putchar=assembly/host/putchar",
    "asbuild:wasi": "asc assembly/wasi.ts --target wasi --use getchar=assembly/wasiHost/getchar --use putchar=assembly/wasiHost/putchar",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release && npm run asbuild:wasi",
    "start": "npx serve ../assets"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jburgy/blog.git"
  },
  "keywords": [
    "Lisp",
    "AssemblyScript",
    "WASM"
  ],
  "author": "Jan Burgy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jburgy/blog/issues"
  },
  "homepage": "https://github.com/jburgy/blog#readme",
  "devDependencies": {
    "assemblyscript": "^0.27.37",
    "uwasi": "^1.6.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/release.js",
      "types": "./build/release.d.ts"
    }
  },
  "dependencies": {
    "node": "^22.19.0"
  }
}
