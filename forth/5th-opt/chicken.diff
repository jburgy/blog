-#define NEXT __attribute__((musttail)) return ip->word->code(env, sp, rsp, ip + 1, ip->word)
+/* 5th.c in the style of Chicken Scheme ("Cheney on the M.T.A."): no tail calls, so
+   every dispatch is a real call that never returns and the C stack only grows.
+   NEXT checks the depth; past STACK_BYTES it parks the VM registers and longjmps
+   to main, which restarts on an empty stack.  Nothing else is live on the C stack
+   (the Forth stacks are in memory), so Chicken's copying GC has nothing to copy.
+   Build with -fno-optimize-sibling-calls or the compiler turns the calls back into jumps. */
+#ifndef STACK_BYTES
+#define STACK_BYTES 65536
+#endif
+
+#define NEXT do { \
+    if (__builtin_expect(read_sp() < stack_limit, 0)) { \
+        resume.sp = sp; resume.rsp = rsp; resume.ip = ip; \
+        longjmp(reset, 1); \
+    } \
+    return ip->word->code(env, sp, rsp, ip + 1, ip->word); \
+} while (0)
 #define DEFCODE_(_link, _flag, _name, _label) \
 intptr_t *_label(struct interp_t *, intptr_t *, union instr_t **, union instr_t *, union instr_t *); \
 static struct word_t name_##_label __attribute__((used)) = {.link = _link, .flag = _flag | ((sizeof _name) - 1), .name = _name, .code = {.code = _label}}; \
@@ -58,6 +75,25 @@
 };
 
 enum Flags {F_IMMED=0x80, F_HIDDEN=0x20, F_LENMASK=0x1f};
+
+static inline char *read_sp(void)
+{
+#if defined(__aarch64__)
+    char *p;
+    __asm__("mov %0, sp" : "=r"(p));
+    return p;
+#elif defined(__x86_64__)
+    char *p;
+    __asm__("mov %%rsp, %0" : "=r"(p));
+    return p;
+#else
+    return __builtin_frame_address(0); /* forces a frame in every caller: slower */
+#endif
+}
+
+static jmp_buf reset;
+static char *stack_limit;
+static struct { intptr_t *sp; union instr_t **rsp; union instr_t *ip; } resume;
